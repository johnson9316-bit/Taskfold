{
  "name": "taskfold-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnson9316-bit/Taskfold.git"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "build": "npm run build -w @johnson9316-bit/taskfold && npm run build:cli",
    "build:backend": "npm run build:backend -w @johnson9316-bit/taskfold",
    "build:control-ui": "npm run build:control-ui -w @johnson9316-bit/taskfold",
    "build:cli": "npm run build -w @taskfold/cli",
    "check:public-names": "node scripts/check-public-names.mjs",
    "pack:check": "npm run pack:check -w @johnson9316-bit/taskfold",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
