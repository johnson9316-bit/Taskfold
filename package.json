{
  "name": "@johnson9316-bit/taskfold",
  "version": "0.2.0",
  "description": "Project, milestone, documentation, and execution boards for OpenClaw.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnson9316-bit/Taskfold.git"
  },
  "bugs": {
    "url": "https://github.com/johnson9316-bit/Taskfold/issues"
  },
  "homepage": "https://github.com/johnson9316-bit/Taskfold#readme",
  "engines": {
    "node": ">=24.16.0"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "kanban",
    "project-management",
    "milestones",
    "worktree"
  ],
  "files": [
    "dist/",
    "ui/dist/",
    "docs/CLAW_HUB_PUBLISHING.md",
    "LICENSE",
    "README.md",
    "THIRD-PARTY-NOTICES",
    "UPSTREAM.md",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "npm run build:backend && npm run build:ui",
    "build:backend": "esbuild src/backend/index.ts src/backend/doctor-contract-api.ts --bundle --format=esm --platform=node --target=node22 --outdir=dist --external:openclaw --external:openclaw/*",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:control-ui": "node scripts/build-control-ui.mjs",
    "check:public-names": "node scripts/check-public-names.mjs",
    "dev": "vite --config ui/vite.config.ts --host 127.0.0.1",
    "pack:check": "npm pack --dry-run",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@noble/ed25519": "^3.0.0",
    "commander": "^13.1.0",
    "dompurify": "^3.4.12",
    "lit": "^3.3.0",
    "marked": "^15.0.12",
    "turndown": "^7.2.4",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.25.0",
    "openclaw": "2026.9.4",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1 <2027.0.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.9.4"
    }
  }
}
