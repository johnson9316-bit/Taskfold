{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": [
      "node"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "packages/openclaw/src/**/*.ts",
    "packages/core/src/**/*.ts",
    "packages/cli/src/**/*.ts",
    "test/**/*.ts",
    "packages/ui/src/index.ts",
    "packages/ui/src/vscode-index.ts"
  ]
}
